# Backend API URL (change to your actual backend server URL in production)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/auth

# Third-party services (e.g., for payments, analytics) - Update with your actual keys
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Cloudinary (for image uploads, if you are using Cloudinary in the project)
NEXT_PUBLIC_CLOUDINARY_URL=your_cloudinary_url_here

# JWT Secret (This is for backend use, not directly in frontend .env files)
JWT_SECRET=your_jwt_secret_here

# Database connection (if relevant, though often not directly in frontend .env files)
MONGODB_URI=your_mongodb_connection_string_here

# Additional configurations, if relevant
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Any other secrets for third-party APIs
NEXT_PUBLIC_OTHER_API_KEY=your_other_api_key_here