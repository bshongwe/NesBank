# =======================
# Frontend (Public) Variables
# =======================

# Backend API URL (for frontend to make requests to your backend API)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/auth

# Stripe public key for frontend operations
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# PayPal client ID for frontend (used in PayPal buttons)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Cloudinary URL for image uploads (if Cloudinary is used for images)
NEXT_PUBLIC_CLOUDINARY_URL=your_cloudinary_url_here

# Google Analytics ID for tracking (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Public API key for other third-party services (optional)
NEXT_PUBLIC_OTHER_API_KEY=your_other_api_key_here


# =======================
# Backend (Private) Variables
# =======================

# JWT secret key used for token generation and validation in backend
JWT_SECRET=your_jwt_secret_here

# MongoDB connection string (used for backend database connection)
MONGODB_URI=your_mongodb_connection_string_here

# Stripe private key for secure server-side payment processing
STRIPE_API_KEY=your_stripe_secret_key_here

# PayPal client ID for server-side PayPal integrations (for creating payments, etc.)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
